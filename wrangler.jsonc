{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bumplog",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // Nightly: drop reports past their retention window.
  "triggers": { "crons": ["17 4 * * *"] },

  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bumplog",
      "database_id": "69ea5a99-d103-4ce6-abc6-bfda6d0d9c99",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "be240ba7313249859cf45bd6ad514a3b"
    }
  ]
}
