{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bumplog",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // The custom domain is the only host. Without workers_dev:false every deploy
  // re-enables the workers.dev route, which would serve the same pages under a
  // second hostname — each canonicalising to itself, splitting search signal.
  "workers_dev": false,
  "routes": [{ "pattern": "bumplog.sehahub.info", "custom_domain": true }],

  // Nightly: drop reports past their retention window.
  "triggers": { "crons": ["17 4 * * *"] },

  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bumplog",
      "database_id": "69ea5a99-d103-4ce6-abc6-bfda6d0d9c99",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "be240ba7313249859cf45bd6ad514a3b"
    }
  ]
}
